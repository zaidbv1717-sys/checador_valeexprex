DATABASE_URL=postgresql://reloj:reloj@localhost:5432/reloj_checador
PORT=8000
MAX_BACKUPS=30
DEVICE_ALERT_WINDOW_MIN=5
DEFAULT_ADMIN_PASSWORD=1234
# Zona horaria de la oficina. Mazatlan es MST (-0700) y NO comparte hora con
# Ciudad de Mexico (CST, -0600).
OFFICE_TZ=America/Mazatlan
# Tope de subida de fotos en bytes (8 MB).
MAX_PHOTO_BYTES=8388608
