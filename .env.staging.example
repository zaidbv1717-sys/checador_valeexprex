# ============================================================
# Variables del Reloj Checador en el VPS de STAGING
# ============================================================
# Copiar a `.env.staging` EN EL VPS (nunca en git: .gitignore ya excluye .env*)
# y rellenar los tres valores marcados. Sin ellos el compose ABORTA a proposito
# en vez de arrancar con credenciales de fabrica expuestas a internet.
#
#   cp .env.staging.example .env.staging
#   openssl rand -base64 24     # para cada contrasena
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
# ============================================================

# --- Base de datos (obligatorias) ---
POSTGRES_USER=reloj
# NO dejar `reloj`: aunque el puerto no se publica, esta contrasena viaja al
# volumen y a los respaldos.
POSTGRES_PASSWORD=CAMBIAR_openssl_rand_base64_24
POSTGRES_DB=reloj_checador

# --- Panel de administracion (obligatoria) ---
# El compose de la oficina trae `1234` por defecto. En staging la API es
# alcanzable desde internet a traves del nginx del host, y 4 digitos se agotan
# en segundos. Minimo 16 caracteres.
DEFAULT_ADMIN_PASSWORD=CAMBIAR_openssl_rand_base64_24

# --- Zona horaria ---
# El VPS corre en UTC (timedatectl -> Etc/UTC). Sin esto, una jornada que termina
# despues de las 17:00 cruza de dia y se contabiliza como cero horas trabajadas
# mas una falta falsa. Mazatlan es MST (-0700) y NO comparte hora con CDMX.
TZ=America/Mazatlan
OFFICE_TZ=America/Mazatlan

# --- Puertos en el host (solo 127.0.0.1; el nginx del host publica) ---
# 8085 y 8001 estan libres en el VPS; 80, 443, 3000, 5432, 8081, 8083 y 8084 ya
# los usan nginx y ValeExpress.
FRONTEND_PORT=8085
BACKEND_PORT=8001

# --- Endurecimiento para internet ---
# Sin esto /docs publica el mapa completo de la API a cualquiera.
DOCS_ENABLED=false
# Origenes permitidos por CORS. `*` es el default del compose de oficina (LAN de
# confianza); en internet se acota al dominio real del checador.
CORS_ORIGINS=https://checador.staging.valeexpress.mx

# --- Operacion ---
MAX_BACKUPS=30
DEVICE_ALERT_WINDOW_MIN=5

# --- SMTP (opcional) ---
# Sin esto, el codigo de recuperacion generado en Ajustes solo se muestra en
# pantalla; con esto, tambien se manda al correo oficial configurado ahi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
